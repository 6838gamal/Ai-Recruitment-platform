# ============================================================
# AI Recruitment Platform — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ─── Application ────────────────────────────────────────────
APP_NAME="AI Recruitment Platform"
APP_ENV=development          # development | staging | production
DEBUG=true
SECRET_KEY=change-me-to-64-random-hex-characters-in-production
ALLOWED_HOSTS=*              # comma-separated or * for all

# ─── Database ───────────────────────────────────────────────
# PostgreSQL connection string (Replit provides this automatically)
DATABASE_URL=postgresql://gamalalmaqtary:mfpNMrFTCQlurkpwuCXj88w3A042Z7hc@dpg-d9reg07avr4c7392ub3g-a.virginia-postgres.render.com/ai_recruitment_platform_db
# Or use individual vars:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=yourpassword
# PGDATABASE=ai_recruitment

# ─── JWT / Security ─────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ───────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# ─── Email (SMTP) ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
FROM_EMAIL=noreply@yourcompany.com
FROM_NAME="AI Recruitment Platform"

# ─── AI Provider ────────────────────────────────────────────
AI_PROVIDER=openai           # openai | anthropic | local
AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini         # or claude-3-haiku-20240307
AI_BASE_URL=                 # optional, for local LLM (Ollama)

# ─── File Storage ───────────────────────────────────────────
STORAGE_BACKEND=local        # local | s3 | supabase
LOCAL_UPLOAD_DIR=./uploads

# AWS S3 (if STORAGE_BACKEND=s3)
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_ACCESS_KEY=AKIA...
S3_SECRET_KEY=...

# Supabase (if STORAGE_BACKEND=supabase)
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=eyJ...
SUPABASE_BUCKET=resumes

# ─── WhatsApp ───────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=100/minute

# ─── Pagination ─────────────────────────────────────────────
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100

# ─── File Upload Limits ──────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
